<form bindsubmit="formSubmit">
<view style="margin-top:50rpx;">
</view>
<van-cell-group>
  <van-field
    name="userName"
    required
    clearable
    label="用户名"
    icon="question-o"
    placeholder="请输入用户名"
    />

  <van-field
    name="userPassword"
    type="password"
    label="密码"
    placeholder="请输入密码"
    required
    border="{{ false }}"
  />
</van-cell-group>

<button class="anniu" form-type="submit">登陆</button>
</form>

